<!doctype html>
<html lang="de"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> · Sartu Portal</title>
<link rel="stylesheet" href="/public/portal.css">
</head>
<body class="theme-<%= theme %>">
<header class="topbar"><div class="bar">
  <a class="brand" href="<%= theme==='admin'?'/admin':'/portal' %>">Sartu <span>Portal</span></a>
  <nav>
    <% if (typeof user !== 'undefined' && user) { %>
      <span class="who"><%= user.type==='admin' ? (user.admin && user.admin.email) : (user.kunde && (user.kunde.firma || user.kunde.email)) %></span>
      <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrf || '' %>"><button class="linkbtn">Abmelden</button></form>
    <% } %>
  </nav>
</div></header>
<main class="wrap">
