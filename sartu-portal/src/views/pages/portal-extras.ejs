<%- include('../partials/head') %>
<p class="muted"><a href="/portal/projekt/<%= projekt.id %>">‹ Zurück zum Projekt</a></p>
<h1>Extras nachbuchen</h1>
<p class="muted">Klick = unverbindliche Anfrage. Preise wie auf der Website. Keine Zahlung im Portal.</p>
<div class="grid">
<% function card(k,it){ var preis = it.type==='percent' ? ('+'+it.pct+' % je Sprache') : (it.price.toLocaleString('de-DE')+' €'+(it.monthly?(' + '+it.monthly+' €/Mon.'):'')); %>
  <form class="card" method="post" action="/portal/projekt/<%= projekt.id %>/extras/anfrage">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="key" value="<%= k %>">
    <div class="cardtitle"><%= it.name %></div>
    <div class="kicker"><%= preis %></div>
    <button class="btn ghost">Anfragen</button>
  </form>
<% } Object.keys(extras).forEach(function(k){ card(k, extras[k]); }); Object.keys(seoStufen).forEach(function(k){ card(k, seoStufen[k]); }); %>
</div>
<%- include('../partials/foot') %>
