<%- include('../partials/head') %>
<p class="muted"><a href="/portal/projekt/<%= projekt.id %>">‹ Zurück zum Projekt</a></p>
<h1>Care & Betreuung</h1>
<p class="muted">Rundum-Schutz <strong><%= careName %></strong> · Monat <%= monat %>.</p>

<div class="card">
  <h2>Inklusiv-Minuten diesen Monat</h2>
  <% rows.forEach(function(r){ var pct = r.max ? Math.min(100, Math.round(r.verbraucht/r.max*100)) : 0; %>
    <div class="bar-row">
      <div class="bar-label"><% if (rows.length>1){ %>Sprachversion <%= r.sprachversion %>: <% } %><%= r.verbraucht %>/<%= r.max %> Min · <%= r.verbleibend %> übrig</div>
      <div class="bar"><span style="width:<%= pct %>%"></span></div>
    </div>
  <% }) %>
  <p class="muted small">Nicht genutzte Minuten verfallen am Monatsende. Änderungen laufen gegen dieses Kontingent, Störungen nicht.</p>
</div>

<div class="card grid2">
  <form method="post" action="/portal/projekt/<%= projekt.id %>/ticket">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="typ" value="stoerung">
    <h2>Störung melden</h2>
    <p class="muted small">Etwas funktioniert nicht? Wir reagieren laut Reaktionsklausel (Care-Stufe).</p>
    <label>Was ist passiert?<textarea name="text" rows="3" required></textarea></label>
    <button class="btn">Störung melden</button>
  </form>
  <form method="post" action="/portal/projekt/<%= projekt.id %>/ticket">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="typ" value="aenderung">
    <h2>Änderung wünschen</h2>
    <p class="muted small">Läuft gegen deine Inklusiv-Minuten. Größeres? Wir schicken dir vorher eine Kostenschätzung.</p>
    <label>Was sollen wir ändern?<textarea name="text" rows="3" required></textarea></label>
    <button class="btn ghost">Änderung wünschen</button>
  </form>
</div>

<% var offene = schaetzungen.filter(function(s){return s.status==='offen'}); if (offene.length) { %>
<div class="card">
  <h2>Kostenschätzungen — bitte freigeben</h2>
  <% offene.forEach(function(s){ %>
    <div class="estimate">
      <div><strong><%= s.beschreibung %></strong> — <%= s.minuten_geschaetzt %> Min · <%= s.betrag.toLocaleString('de-DE') %> €</div>
      <div class="row">
        <form method="post" action="/portal/projekt/<%= projekt.id %>/schaetzung/<%= s.id %>/freigeben" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn">Freigeben</button></form>
        <form method="post" action="/portal/projekt/<%= projekt.id %>/schaetzung/<%= s.id %>/ablehnen" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkbtn">ablehnen</button></form>
      </div>
    </div>
  <% }) %>
  <p class="muted small">Erst nach deiner Freigabe arbeiten wir daran.</p>
</div>
<% } %>

<div class="card">
  <h2>Betriebs-Status</h2>
  <p>SSL-Zertifikat gültig bis: <strong><%= projekt.ssl_ablauf || '—' %></strong></p>
  <p>Letzte Sicherung: <strong><%= projekt.letzte_sicherung || '—' %></strong> · Updates eingespielt: <strong><%= projekt.updates_eingespielt || '—' %></strong></p>
</div>

<div class="card">
  <h2>Historie</h2>
  <% if (!buchungen.length) { %><p class="muted">Noch keine Buchungen.</p><% } %>
  <table class="tbl"><tbody>
  <% buchungen.forEach(function(b){ %><tr><td><%= b.datum %></td><td><%= b.beschreibung %></td><td><%= b.minuten %> Min</td><td><%= b.typ %><% if (rows.length>1){ %> · SV<%= b.sprachversion %><% } %></td></tr><% }) %>
  </tbody></table>
</div>
<%- include('../partials/foot') %>
