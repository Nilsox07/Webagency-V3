<%- include('../partials/head') %>
<h1>Prompt-Bausteine</h1>
<p class="muted">Platzhalter in doppelten geschweiften Klammern, z. B. <code>{{firma}}</code>, <code>{{hauptfarbe_hex}}</code>, <code>{{seitenliste}}</code>, <code>{{texte_block}}</code>.</p>
<% bausteine.forEach(function(b){ %>
  <form class="card" method="post" action="/admin/bausteine/<%= b.schluessel %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="kicker"><%= b.schluessel %> · Sortierung <%= b.sortierung %></div>
    <label>Titel<input name="titel" value="<%= b.titel %>"></label>
    <label>Text<textarea name="text" rows="6"><%= b.text %></textarea></label>
    <button class="btn ghost">Speichern</button>
  </form>
<% }) %>
<%- include('../partials/foot') %>
