<%- include('../partials/head') %>
<p class="muted"><a href="/admin">‹ Kunden</a></p>
<h1><%= projekt.name || 'Projekt' %></h1>
<p class="muted">Paket <%= projekt.paket %> · Status <%= projekt.status %> · Runden <%= projekt.runden_verbraucht %>/<%= projekt.runden_max %> · Vorschau-Token <code><%= projekt.vorschau_token %></code></p>
<% runden.forEach(function(r){ %>
  <div class="card">
    <h2>Runde <%= r.runde %> <span class="status status-<%= r.status %>"><%= r.status %></span></h2>
    <% if (!r.pins.length) { %><p class="muted">Keine Anmerkungen.</p><% } %>
    <table class="tbl"><tbody>
    <% r.pins.forEach(function(p){ %>
      <tr>
        <td><span class="status status-<%= p.status %>"><%= p.status %></span></td>
        <td><strong><%= p.text %></strong><br><span class="muted small"><%= p.css_selektor %> · <%= p.viewport_breite %>px · <%= p.seite_pfad %></span></td>
        <td><a href="/vorschau/<%= projekt.vorschau_token %><%= p.seite_pfad %>#<%= p.css_selektor %>" target="_blank">öffnen</a></td>
        <td><% if (p.status !== 'erledigt') { %><form method="post" action="/admin/pin/<%= p.id %>/erledigt" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkbtn">erledigt</button></form><% } %></td>
      </tr>
    <% }) %>
    </tbody></table>
  </div>
<% }) %>
<div class="card">
  <h2>Care-Buchung (5-Minuten-Takt)</h2>
  <form method="post" action="/admin/projekt/<%= projekt.id %>/buchung">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Beschreibung<input name="beschreibung"></label>
    <label>Minuten (5er-Schritte)<input name="minuten" type="number" step="5" min="5"></label>
    <label>Sprachversion<input name="sprachversion" type="number" min="1" value="1"></label>
    <button class="btn">Buchen</button>
  </form>
</div>
<div class="card">
  <h2>Kostenschätzung anlegen</h2>
  <form method="post" action="/admin/projekt/<%= projekt.id %>/schaetzung">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Beschreibung<input name="beschreibung"></label>
    <label>Geschätzte Minuten<input name="minuten_geschaetzt" type="number" min="5" step="5"></label>
    <button class="btn">Schätzung an Kunde senden</button>
  </form>
  <p class="muted small">Betrag wird automatisch berechnet (150 €/Std anteilig).</p>
</div>
<%- include('../partials/foot') %>