<%- include('../partials/head') %>
<p class="muted"><a href="/admin">‹ Alle Kunden</a></p>
<h1><%= kunde.firma || kunde.email %></h1>
<p class="muted"><%= kunde.email %> · <%= kunde.telefon || 'keine Telefonnummer' %></p>
<h2>Projekte</h2>
<table class="tbl">
  <thead><tr><th>Name</th><th>Paket</th><th>Status</th></tr></thead>
  <tbody>
  <% projekte.forEach(function(p){ %>
    <tr><td><%= p.name || '—' %></td><td><%= p.paket %></td><td><%= p.status %></td></tr>
  <% }) %>
  </tbody>
</table>
<%- include('../partials/foot') %>
