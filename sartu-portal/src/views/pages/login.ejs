<%- include('../partials/head') %>
<div class="card narrow">
  <h1>Anmelden</h1>
  <% if (sent) { %>
    <p class="ok">Wenn die E-Mail bei uns hinterlegt ist, haben wir dir gerade einen Anmelde-Link geschickt. Er gilt 15&nbsp;Minuten und nur einmal.</p>
    <p class="muted">Keine Mail bekommen? <a href="/login">Nochmal anfordern</a>.</p>
  <% } else { %>
    <p class="muted">Gib deine E-Mail ein — wir schicken dir einen Link ins Portal. Kein Passwort nötig.</p>
    <% if (error) { %><p class="err"><%= error %></p><% } %>
    <form method="post" action="/login">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>E-Mail<input type="email" name="email" required autocomplete="email" placeholder="du@firma.de"></label>
      <button class="btn">Link schicken</button>
    </form>
  <% } %>
  <p class="muted small"><a href="/admin/login">Admin-Anmeldung</a></p>
</div>
<%- include('../partials/foot') %>
