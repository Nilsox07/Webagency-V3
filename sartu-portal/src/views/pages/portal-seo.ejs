<%- include('../partials/head') %>
<p class="muted"><a href="/portal/projekt/<%= projekt.id %>">‹ Zurück zum Projekt</a></p>
<h1>SEO-Betreuung</h1>
<% if (!aktiv) { %>
  <div class="card"><p class="muted">Aktuell keine aktive SEO-Betreuung. Du kannst sie unter <a href="/portal/projekt/<%= projekt.id %>/extras">Extras</a> anfragen.</p></div>
<% } else { %>
  <div class="card">
    <h2><%= stufeInfo.name %> · <%= stufeInfo.price %> €/Mon.</h2>
    <p class="muted small">Monatlich, nach 3 Monaten kündbar.</p>
  </div>
  <div class="card">
    <h2>Kontingent <%= kontingent ? '' : '(noch nicht angelegt)' %> — verfällt am <%= verfall %></h2>
    <% if (kontingent) { %>
      <ul>
        <li>Seiten-Refreshes: <strong><%= kontingent.refresh_verbraucht %>/<%= kontingent.refresh_max %></strong></li>
        <li>Neue Seiten: <strong><%= kontingent.seiten_verbraucht %>/<%= kontingent.seiten_max %></strong></li>
        <li>Keyword-Tracking: bis <strong><%= kontingent.tracking_max %></strong></li>
      </ul>
    <% } else { %><p class="muted">Für diesen Monat ist noch kein Kontingent hinterlegt.</p><% } %>
  </div>
  <div class="card">
    <h2>Dokumente</h2>
    <% if (!dokumente.length) { %><p class="muted">Noch keine Reports/Pläne.</p><% } %>
    <ul><% dokumente.forEach(function(d){ %><li><%= d.typ %> <%= d.monat %><% if (d.pdf_pfad){ %> — <a href="/portal/upload/<%= d.id %>">PDF</a><% } %></li><% }) %></ul>
  </div>
  <div class="card grid2">
    <form method="post" action="/portal/projekt/<%= projekt.id %>/seo/wechsel">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <h2>Stufe wechseln</h2>
      <label>Ziel-Stufe<select name="ziel_stufe"><% Object.keys(seoStufen).forEach(function(k){ %><option value="<%= k %>"><%= seoStufen[k].name %> (<%= seoStufen[k].price %> €)</option><% }) %></select></label>
      <button class="btn ghost">Wechsel anfragen</button>
    </form>
    <form method="post" action="/portal/projekt/<%= projekt.id %>/seo/kuendigung">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <h2>Kündigen</h2>
      <p class="muted small">Monatlich nach 3 Monaten Mindestlaufzeit.</p>
      <button class="linkbtn">Kündigung anfragen</button>
    </form>
  </div>
<% } %>
<%- include('../partials/foot') %>
