<%- include('../partials/head') %>
<h1>Tickets</h1>
<p class="muted">Filter:
  <a href="/admin/tickets">alle</a> ·
  <% ['stoerung','aenderung','extra_anfrage','postfach','domain','abnahme_garantie','loeschung'].forEach(function(t){ %><a href="/admin/tickets?typ=<%= t %>"<%= typ===t?' style="font-weight:800"':'' %>><%= t %></a> <% }) %>
</p>
<table class="tbl"><thead><tr><th>Typ</th><th>Kunde</th><th>Text</th><th>Status</th><th>Datum</th></tr></thead><tbody>
<% tickets.forEach(function(t){ %><tr><td><%= t.typ %></td><td><%= t.email %></td><td><%= t.text %></td><td><%= t.status %></td><td><%= t.created_at %></td></tr><% }) %>
</tbody></table>
<%- include('../partials/foot') %>
