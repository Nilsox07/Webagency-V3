<%- include('../partials/head') %>
<p class="muted"><a href="/portal">‹ Übersicht</a></p>
<h1><%= projekt.name || 'Dein Webprojekt' %></h1>
<div class="status status-<%= projekt.status %>">Status: <%= projekt.status %></div>

<% if (countdown !== null) { %>
  <div class="card"><strong>Liefertermin:</strong> noch <%= countdown %> Tage<% if (projekt.liefertermin){ %> (bis <%= projekt.liefertermin %>)<% } %>.
  <p class="muted small">Der Countdown läuft, seit deine Inhalte vollständig sind.</p></div>
<% } %>

<% if (blockers.length) { %>
  <div class="card blocker">
    <h2>Das fehlt gerade von dir</h2>
    <ul>
      <% blockers.forEach(function(b){ %><li><a href="<%= b.href %>"><%= b.text %></a></li><% }) %>
    </ul>
  </div>
<% } else { %>
  <div class="card"><p class="ok">Von deiner Seite ist gerade nichts offen. Wir sind dran. 👍</p></div>
<% } %>

<div class="card">
  <h2>Phasen</h2>
  <ol class="timeline">
    <% timeline.forEach(function(p){ %><li class="phase phase-<%= p.state %>"><span class="dot"></span><%= p.label %></li><% }) %>
  </ol>
</div>

<div class="card">
  <h2>Zahlung in Meilensteinen</h2>
  <p class="muted small">Übersicht — die Pflege erfolgt durch Sartu (Online-Zahlung folgt).</p>
  <table class="tbl"><thead><tr><th>Meilenstein</th><th>Betrag</th><th>fällig</th><th>Status</th></tr></thead><tbody>
  <% meilensteine.forEach(function(m){ %>
    <tr><td><%= m.bezeichnung %></td><td><%= m.betrag.toLocaleString('de-DE') %> €</td><td><%= m.faellig || '—' %></td><td><span class="status status-<%= m.status %>"><%= m.status %></span></td></tr>
  <% }) %>
  </tbody></table>
</div>

<p><a class="btn" href="/portal/projekt/<%= projekt.id %>/inhalte">Inhalte bearbeiten</a>
   <a class="btn ghost" href="/portal/projekt/<%= projekt.id %>/dokumente">Dokumente</a></p>
<%- include('../partials/foot') %>
