<%- include('../partials/head') %>
<h1>Kunden</h1>
<table class="tbl">
  <thead><tr><th>Firma</th><th>E-Mail</th><th>Projekte</th><th></th></tr></thead>
  <tbody>
  <% kunden.forEach(function(k){ %>
    <tr><td><%= k.firma || '—' %></td><td><%= k.email %></td><td><%= k.projekte %></td>
        <td><a href="/admin/kunde/<%= k.id %>">öffnen ›</a></td></tr>
  <% }) %>
  </tbody>
</table>
<%- include('../partials/foot') %>
